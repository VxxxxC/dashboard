# Copy this file to credentials.yml and fill in your own values before starting the app.
#
# To hash a password:
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt(12)).decode())"
#
# To generate a secure cookie key:
#   python3 -c "import secrets; print(secrets.token_hex(32))"

credentials:
  usernames:
    admin:
      email: your@email.com
      name: Your Name
      logged_in: False
      password: <bcrypt-hashed-password>
cookie:
  expiry_days: 30
  key: <long-random-secret>   # Must be a string; use secrets.token_hex(32)
  name: hummingbot_dashboard_auth
pre-authorized:
  emails:
  - your@email.com
